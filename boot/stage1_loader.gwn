; GrOS stage-1 loader
; .gwn is low-level source.
; This raw-byte source is consumed by scripts/gwnraw.sh.

raw x86.bios.stage1 {
    origin 7C00

    ; setup segments and stack
    bytes FA
    bytes 31 C0
    bytes 8E D8
    bytes 8E C0
    bytes 8E D0
    bytes BC 00 7C
    bytes FB
    bytes FC

    ; preserve BIOS boot drive
    bytes 88 16
    addr16 boot_drive

    ; reset disk
    bytes 31 C0
    bytes 8A 16
    addr16 boot_drive
    bytes CD 13
    bytes 72
    rel8 disk_error_jump

    ; restore data/load segments before the read
    bytes 31 C0
    bytes 8E D8
    bytes 8E C0

    ; read stage-2 sectors from CHS 0:0:2 into 0000:8000
    bytes B8 04 02
    bytes BB 00 80
    bytes B9 02 00
    bytes 30 F6
    bytes 8A 16
    addr16 boot_drive
    bytes CD 13
    bytes 72
    rel8 disk_error_jump
    bytes EB
    rel8 header_validate

    label disk_error_jump
    bytes E9
    rel16 disk_error

    label header_validate
    ; validate the fixed stage-2 GWO header at 0000:8000
    bytes 81 3E 00 80 47 52
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 02 80 4F 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 04 80 20 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 06 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 08 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 0A 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 0C 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 14 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 16 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 18 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 1A 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 1C 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 1E 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes 81 3E 12 80 00 00
    bytes 0F 85
    rel16 disk_error
    bytes A1 10 80
    bytes 09 C0
    bytes 0F 84
    rel16 disk_error
    bytes 3D E0 07
    bytes 0F 87
    rel16 disk_error
    bytes 8B 1E 0E 80
    bytes 39 C3
    bytes 0F 83
    rel16 disk_error

    ; restore validated payload entry state
    bytes FA
    bytes 31 C0
    bytes 8E D8
    bytes 8E C0
    bytes 8E D0
    bytes BC 00 7C
    bytes FB
    bytes FC
    bytes 8A 16
    addr16 boot_drive

    ; transfer to 0000:(8020h + validated entry_offset)
    bytes 81 C3 20 80
    bytes 6A 00
    bytes 53
    bytes CB

    label disk_error
    bytes 31 C0
    bytes 8E D8
    bytes BE
    addr16 disk_error_text
    bytes E8
    rel16 print_string
    bytes FA

    label halt
    bytes F4
    bytes EB
    rel8 halt

    ; print_string subroutine
    label print_string
    bytes AC
    bytes 84 C0
    bytes 74
    rel8 print_done
    bytes B4 0E
    bytes CD 10
    bytes EB
    rel8 print_string

    label print_done
    bytes C3

    label disk_error_text
    ascii "disk\r\n"
    byte 00

    label boot_drive
    byte 00

    pad_to 510 with 00
    signature 55 AA
}
